<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="cart_items" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="details" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="copex-warranty-garan-item" xsi:type="array">
                                                                    <item name="component" xsi:type="string">CopeX_WarrantyLabel/js/view/checkout/garan-item</item>
                                                                    <item name="sortOrder" xsi:type="string">200</item>
                                                                    <item name="displayArea" xsi:type="string">after_details</item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                                <item name="before-place-order" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="copex-warranty-notice" xsi:type="array">
                                                            <item name="component" xsi:type="string">CopeX_WarrantyLabel/js/view/checkout/notice</item>
                                                            <item name="sortOrder" xsi:type="string">50</item>
                                                            <item name="displayArea" xsi:type="string">before-place-order</item>
                                                        </item>
                                                        <item name="copex-warranty-garan-summary" xsi:type="array">
                                                            <item name="component" xsi:type="string">CopeX_WarrantyLabel/js/view/checkout/garan-summary</item>
                                                            <item name="sortOrder" xsi:type="string">60</item>
                                                            <item name="displayArea" xsi:type="string">before-place-order</item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
