<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <block class="Magento\Framework\View\Element\Template"
                   name="copex.warrantylabel.notice.cart"
                   template="CopeX_WarrantyLabel::notice.phtml"
                   after="checkout.cart.totals.container"
                   ifconfig="copex_warrantylabel/general/enabled">
                <arguments>
                    <argument name="view_model" xsi:type="object">CopeX\WarrantyLabel\ViewModel\Notice</argument>
                    <argument name="placement" xsi:type="string">cart</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
