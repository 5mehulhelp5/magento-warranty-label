<?xml version="1.0"?>
<!--
    Hyvä adds a "hyva_" prefixed copy of every layout handle while a Hyvä theme is active
    (Hyva\Theme\Observer\AddLayoutHandles), so this file never applies to Luma.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="copex.warrantylabel.hyva.script"
                   template="CopeX_WarrantyLabel::hyva/script.phtml"
                   after="copex.warrantylabel.styles"
                   ifconfig="copex_warrantylabel/general/enabled">
                <arguments>
                    <argument name="view_model" xsi:type="object">CopeX\WarrantyLabel\ViewModel\Notice</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
